{
  "renderBackend":      { "type": "dropdown", "value": 0, "text": "Render backend (restart)", "items": ["OpenGL compute", "Vulkan"] },
  "particleBackend":    { "type": "dropdown", "value": 0, "text": "Particle backend (restart)", "items": ["Auto (CUDA if available)", "CUDA", "Compute shader"] },
  "displayScaling":     { "type": "slider", "value": 1.0, "min": 0.1, "max": 4.0, "step": 0.05, "text": "Render scale (resolution)" },
  "samples":            { "type": "slider", "value": 2, "min": 1, "max": 64, "step": 1, "text": "Samples per pixel" },
  "maxSteps":           { "type": "slider", "value": 400, "min": 32, "max": 4096, "step": 16, "text": "Ray-march steps" },
  "stepSize":           { "type": "slider", "value": 0.35, "min": 0.05, "max": 1.0, "step": 0.01, "text": "Step size" },
  "fpsLock":            { "type": "dropdown", "value": 2, "text": "Frame rate", "items": ["Unlimited", "30", "60", "120", "144"] },
  "temporalBlend":      { "type": "slider", "value": 0.0, "min": 0.0, "max": 0.95, "step": 0.01, "text": "Temporal accumulation" },
  "bloomChk":           { "type": "checkbox", "value": true, "text": "Bloom" },

  "diskBrightness":     { "type": "slider", "value": 1.0, "min": 0.0, "max": 4.0, "step": 0.05, "text": "Disk brightness" },
  "diskTemperature":    { "type": "slider", "value": 6500, "min": 2000, "max": 30000, "step": 250, "text": "Disk temperature (K)" },
  "diskInner":          { "type": "slider", "value": 3.0, "min": 1.5, "max": 8.0, "step": 0.1, "text": "Disk inner radius (rs)" },
  "diskOuter":          { "type": "slider", "value": 14.0, "min": 5.0, "max": 40.0, "step": 0.5, "text": "Disk outer radius (rs)" },
  "diskSpeed":          { "type": "slider", "value": 1.0, "min": 0.0, "max": 5.0, "step": 0.05, "text": "Disk rotation speed" },
  "diskOpacity":        { "type": "slider", "value": 0.85, "min": 0.0, "max": 1.0, "step": 0.01, "text": "Disk opacity" },
  "diskRotation":       { "type": "dropdown", "value": 0, "text": "Disk direction", "items": ["Counter-clockwise", "Clockwise"] },
  "diskNoiseScale":     { "type": "slider", "value": 1.0, "min": 0.2, "max": 4.0, "step": 0.05, "text": "Disk detail" },
  "dopplerStrength":    { "type": "slider", "value": 1.0, "min": 0.0, "max": 1.0, "step": 0.01, "text": "Doppler beaming" },
  "redshiftStrength":   { "type": "slider", "value": 1.0, "min": 0.0, "max": 1.0, "step": 0.01, "text": "Gravitational redshift" },

  "starDensity":        { "type": "slider", "value": 0.5, "min": 0.0, "max": 1.0, "step": 0.01, "text": "Star density" },
  "starBrightness":     { "type": "slider", "value": 1.0, "min": 0.0, "max": 4.0, "step": 0.05, "text": "Star brightness" },
  "nebulaBrightness":   { "type": "slider", "value": 1.0, "min": 0.0, "max": 4.0, "step": 0.05, "text": "Milky Way / nebula" },

  "cameraDistance":     { "type": "slider", "value": 22.0, "min": 6.0, "max": 80.0, "step": 0.5, "text": "Camera distance (rs)" },
  "cameraInclination":  { "type": "slider", "value": 8.0, "min": -80.0, "max": 80.0, "step": 1.0, "text": "Camera inclination (deg)" },
  "cameraOrbitSpeed":   { "type": "slider", "value": 0.25, "min": -5.0, "max": 5.0, "step": 0.05, "text": "Camera orbit (deg/s)" },
  "fov":                { "type": "slider", "value": 55.0, "min": 15.0, "max": 120.0, "step": 1.0, "text": "Field of view" },
  "parallaxIntensity":  { "type": "slider", "value": 1.0, "min": 0.0, "max": 5.0, "step": 0.1, "text": "Mouse parallax" },
  "parallaxDamp":       { "type": "slider", "value": 0.08, "min": 0.01, "max": 1.0, "step": 0.01, "text": "Parallax damping" },

  "exposure":           { "type": "slider", "value": 1.2, "min": 0.05, "max": 6.0, "step": 0.05, "text": "Exposure" },
  "bloomStrength":      { "type": "slider", "value": 0.6, "min": 0.0, "max": 3.0, "step": 0.05, "text": "Bloom strength" },
  "bloomThreshold":     { "type": "slider", "value": 0.9, "min": 0.0, "max": 4.0, "step": 0.05, "text": "Bloom threshold" },

  "particlesChk":       { "type": "checkbox", "value": true, "text": "Cursor particles" },
  "particleCount":      { "type": "slider", "value": 200000, "min": 0, "max": 4000000, "step": 10000, "text": "Particle pool size" },
  "particleEmitRate":   { "type": "slider", "value": 20000, "min": 0, "max": 400000, "step": 1000, "text": "Emission rate (/s)" },
  "particleSpeed":      { "type": "slider", "value": 8.0, "min": 0.1, "max": 40.0, "step": 0.1, "text": "Particle speed" },
  "particleSize":       { "type": "slider", "value": 2.0, "min": 0.2, "max": 10.0, "step": 0.1, "text": "Particle size" },
  "particleBrightness": { "type": "slider", "value": 1.0, "min": 0.0, "max": 8.0, "step": 0.05, "text": "Particle brightness" },
  "particleLife":       { "type": "slider", "value": 12.0, "min": 1.0, "max": 60.0, "step": 0.5, "text": "Particle life (s)" },
  "particleSpawnRadius":{ "type": "slider", "value": 1.0, "min": 0.05, "max": 6.0, "step": 0.05, "text": "Spawn radius (rs)" },
  "particleOrbitBias":  { "type": "slider", "value": 1.0, "min": 0.0, "max": 1.5, "step": 0.05, "text": "Orbit vs. plunge" },
  "particleDrag":       { "type": "slider", "value": 0.05, "min": 0.0, "max": 1.0, "step": 0.01, "text": "Drag (inspiral rate)" },
  "particleSpread":     { "type": "slider", "value": 0.3, "min": 0.0, "max": 1.0, "step": 0.01, "text": "Velocity spread" },
  "mouseIdleTimeout":   { "type": "slider", "value": 4.0, "min": 0.0, "max": 30.0, "step": 0.5, "text": "Emit for N s after cursor stops (0 = always)" },
  "lensStrength":       { "type": "slider", "value": 1.0, "min": 0.0, "max": 3.0, "step": 0.05, "text": "Particle lensing" },

  "globalMouse":        { "type": "checkbox", "value": true, "text": "Track cursor outside the window" },
  "debug":              { "type": "checkbox", "value": false, "text": "Debug panel" }
}
